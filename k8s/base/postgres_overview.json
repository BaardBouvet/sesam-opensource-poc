{
    "title": "PostgreSQL",
    "uid": "sesam-postgres",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "30s",
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "panels": [
        {
            "id": 1,
            "type": "stat",
            "title": "Postgres Up",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 4,
                "h": 4
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "DOWN",
                                    "color": "dark-red",
                                    "index": 0
                                },
                                "1": {
                                    "text": "UP",
                                    "color": "dark-green",
                                    "index": 1
                                }
                            }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "dark-red",
                                "value": null
                            },
                            {
                                "color": "dark-green",
                                "value": 1
                            }
                        ]
                    },
                    "color": {
                        "mode": "thresholds"
                    },
                    "noValue": "DOWN",
                    "unit": "short"
                }
            },
            "targets": [
                {
                    "expr": "pg_up",
                    "refId": "A",
                    "instant": true
                }
            ],
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            }
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Uptime",
            "gridPos": {
                "x": 4,
                "y": 0,
                "w": 4,
                "h": 4
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "colorMode": "value",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "text",
                                "value": null
                            }
                        ]
                    },
                    "color": {
                        "mode": "thresholds"
                    }
                }
            },
            "targets": [
                {
                    "expr": "time() - pg_postmaster_start_time_seconds",
                    "refId": "A",
                    "instant": true
                }
            ],
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            }
        },
        {
            "id": 3,
            "type": "stat",
            "title": "Active Connections",
            "gridPos": {
                "x": 8,
                "y": 0,
                "w": 4,
                "h": 4
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "colorMode": "background",
                "graphMode": "area",
                "textMode": "value",
                "justifyMode": "center"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "dark-green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 50
                            },
                            {
                                "color": "dark-red",
                                "value": 90
                            }
                        ]
                    },
                    "color": {
                        "mode": "thresholds"
                    }
                }
            },
            "targets": [
                {
                    "expr": "sum(pg_stat_activity_count{state=\"active\"})",
                    "refId": "A",
                    "instant": true
                }
            ],
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            }
        },
        {
            "id": 4,
            "type": "stat",
            "title": "Connection Utilisation",
            "gridPos": {
                "x": 12,
                "y": 0,
                "w": 4,
                "h": 4
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "colorMode": "background",
                "graphMode": "area",
                "textMode": "value",
                "justifyMode": "center"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "dark-green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 0.7
                            },
                            {
                                "color": "dark-red",
                                "value": 0.9
                            }
                        ]
                    },
                    "color": {
                        "mode": "thresholds"
                    }
                }
            },
            "targets": [
                {
                    "expr": "sum(pg_stat_activity_count) / pg_settings_max_connections",
                    "refId": "A",
                    "instant": true
                }
            ],
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            }
        },
        {
            "id": 5,
            "type": "stat",
            "title": "Database Size",
            "gridPos": {
                "x": 16,
                "y": 0,
                "w": 4,
                "h": 4
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "colorMode": "value",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "text",
                                "value": null
                            }
                        ]
                    },
                    "color": {
                        "mode": "thresholds"
                    }
                }
            },
            "targets": [
                {
                    "expr": "pg_database_size_bytes{datname=\"inandout\"}",
                    "refId": "A",
                    "instant": true
                }
            ],
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            }
        },
        {
            "id": 6,
            "type": "stat",
            "title": "Cache Hit Ratio",
            "gridPos": {
                "x": 20,
                "y": 0,
                "w": 4,
                "h": 4
            },
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value",
                "justifyMode": "center"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "dark-red",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 0.90
                            },
                            {
                                "color": "dark-green",
                                "value": 0.99
                            }
                        ]
                    },
                    "color": {
                        "mode": "thresholds"
                    }
                }
            },
            "targets": [
                {
                    "expr": "pg_stat_database_blks_hit{datname=\"inandout\"} / clamp_min(pg_stat_database_blks_hit{datname=\"inandout\"} + pg_stat_database_blks_read{datname=\"inandout\"}, 1)",
                    "refId": "A",
                    "instant": true
                }
            ],
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            }
        },
        {
            "id": 7,
            "type": "timeseries",
            "title": "Transaction Rate (TPS)",
            "gridPos": {
                "x": 0,
                "y": 4,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "rate(pg_stat_database_xact_commit{datname=\"inandout\"}[1m])",
                    "legendFormat": "commits/s",
                    "refId": "A"
                },
                {
                    "expr": "rate(pg_stat_database_xact_rollback{datname=\"inandout\"}[1m])",
                    "legendFormat": "rollbacks/s",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "custom": {
                        "lineWidth": 2
                    }
                }
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            }
        },
        {
            "id": 8,
            "type": "timeseries",
            "title": "Connections by State",
            "gridPos": {
                "x": 12,
                "y": 4,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "pg_stat_activity_count{state=\"active\"}",
                    "legendFormat": "active",
                    "refId": "A"
                },
                {
                    "expr": "pg_stat_activity_count{state=\"idle\"}",
                    "legendFormat": "idle",
                    "refId": "B"
                },
                {
                    "expr": "pg_stat_activity_count{state=\"idle in transaction\"}",
                    "legendFormat": "idle in txn",
                    "refId": "C"
                },
                {
                    "expr": "pg_stat_activity_count{state=\"idle in transaction (aborted)\"}",
                    "legendFormat": "idle in txn (aborted)",
                    "refId": "D"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "custom": {
                        "lineWidth": 2
                    }
                }
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            }
        },
        {
            "id": 9,
            "type": "timeseries",
            "title": "Row Activity Rate",
            "gridPos": {
                "x": 0,
                "y": 12,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "rate(pg_stat_database_tup_inserted{datname=\"inandout\"}[1m])",
                    "legendFormat": "inserted/s",
                    "refId": "A"
                },
                {
                    "expr": "rate(pg_stat_database_tup_updated{datname=\"inandout\"}[1m])",
                    "legendFormat": "updated/s",
                    "refId": "B"
                },
                {
                    "expr": "rate(pg_stat_database_tup_deleted{datname=\"inandout\"}[1m])",
                    "legendFormat": "deleted/s",
                    "refId": "C"
                },
                {
                    "expr": "rate(pg_stat_database_tup_fetched{datname=\"inandout\"}[1m])",
                    "legendFormat": "fetched/s",
                    "refId": "D"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "custom": {
                        "lineWidth": 2
                    }
                }
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            }
        },
        {
            "id": 10,
            "type": "timeseries",
            "title": "Deadlocks & Temp Files",
            "gridPos": {
                "x": 12,
                "y": 12,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "rate(pg_stat_database_deadlocks{datname=\"inandout\"}[5m])",
                    "legendFormat": "deadlocks/s",
                    "refId": "A"
                },
                {
                    "expr": "rate(pg_stat_database_temp_files{datname=\"inandout\"}[5m])",
                    "legendFormat": "temp files created/s",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "custom": {
                        "lineWidth": 2
                    }
                }
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            }
        },
        {
            "id": 11,
            "type": "timeseries",
            "title": "Replication Slot Lag (bytes)",
            "gridPos": {
                "x": 0,
                "y": 20,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "inout_replication_slot_lag_bytes",
                    "legendFormat": "{{slot_name}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "dark-green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 10485760
                            },
                            {
                                "color": "dark-red",
                                "value": 104857600
                            }
                        ]
                    },
                    "custom": {
                        "lineWidth": 2
                    }
                }
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            }
        },
        {
            "id": 12,
            "type": "timeseries",
            "title": "Locks by Mode",
            "gridPos": {
                "x": 12,
                "y": 20,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "pg_locks_count",
                    "legendFormat": "{{mode}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "custom": {
                        "lineWidth": 2
                    }
                }
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            }
        },
        {
            "id": 13,
            "type": "timeseries",
            "title": "Checkpoint Activity",
            "gridPos": {
                "x": 0,
                "y": 28,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "rate(pg_stat_bgwriter_checkpoints_timed_total[5m])",
                    "legendFormat": "timed/s",
                    "refId": "A"
                },
                {
                    "expr": "rate(pg_stat_bgwriter_checkpoints_req_total[5m])",
                    "legendFormat": "requested/s",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "custom": {
                        "lineWidth": 2
                    }
                }
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            }
        },
        {
            "id": 14,
            "type": "timeseries",
            "title": "Buffers Written",
            "gridPos": {
                "x": 12,
                "y": 28,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "rate(pg_stat_bgwriter_buffers_checkpoint_total[5m])",
                    "legendFormat": "checkpoint",
                    "refId": "A"
                },
                {
                    "expr": "rate(pg_stat_bgwriter_buffers_clean_total[5m])",
                    "legendFormat": "bgwriter",
                    "refId": "B"
                },
                {
                    "expr": "rate(pg_stat_bgwriter_buffers_backend_total[5m])",
                    "legendFormat": "backend (direct)",
                    "refId": "C"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "custom": {
                        "lineWidth": 2
                    }
                }
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            }
        }
    ]
}